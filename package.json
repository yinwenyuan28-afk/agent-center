{
  "name": "agentcenter",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "统一管理多个 AI coding agent 的全局配置：指令文件映射、skill 收集分类、第三方 skill 更新、git 版本管理",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:contract": "node scripts/check-contract.mjs",
    "verify": "npm run check:contract && npm run check && npm run build",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@lucide/svelte": "^1.70.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.4",
    "bits-ui": "^2.20.6",
    "clsx": "^2.1.1",
    "svelte": "^5.19.0",
    "svelte-check": "^4.1.4",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^4.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.2.0"
  }
}
