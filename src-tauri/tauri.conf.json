{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "agentcenter",
  "version": "0.3.0",
  "identifier": "dev.leaf.agentcenter",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5731",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "agentcenter",
        "width": 1080,
        "height": 720,
        "minWidth": 860,
        "minHeight": 560,
        "resizable": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
